<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="codex_fast_sma" islocal="false" iscloud="false">fast SMA</variable>
    <variable type="" id="codex_slow_sma" islocal="false" iscloud="false">slow SMA</variable>
    <variable type="" id="codex_trade_count" islocal="false" iscloud="false">session trade count</variable>
    <variable type="" id="codex_net_profit" islocal="false" iscloud="false">session net profit</variable>
  </variables>
  <block type="trade_definition" id="codex_trade_definition" deletable="false" x="20" y="20">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="codex_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="codex_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="codex_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="codex_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="codex_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="codex_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">FALSE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="codex_init_count">
        <field name="VAR" id="codex_trade_count" variabletype="">session trade count</field>
        <value name="VALUE">
          <block type="math_number" id="codex_zero_count">
            <field name="NUM">0</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="codex_init_profit">
            <field name="VAR" id="codex_net_profit" variabletype="">session net profit</field>
            <value name="VALUE">
              <block type="math_number" id="codex_zero_profit">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="notify" id="codex_demo_warning">
                <field name="NOTIFICATION_TYPE">warn</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="codex_demo_warning_text">
                    <field name="TEXT">DEMO ONLY: fixed $1 stake, maximum 4 trades per run, no martingale.</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="codex_trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="codex_duration">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="codex_amount">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <field name="AMOUNT_LIMITS"></field>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="codex_during_purchase" x="850" y="20">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="codex_sell_check">
        <value name="IF0">
          <block type="check_sell" id="codex_check_sell"></block>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="codex_after_purchase" x="850" y="250">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="codex_add_profit">
        <field name="VAR" id="codex_net_profit" variabletype="">session net profit</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="codex_profit_math">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get" id="codex_profit_before">
                <field name="VAR" id="codex_net_profit" variabletype="">session net profit</field>
              </block>
            </value>
            <value name="B">
              <block type="read_details" id="codex_contract_profit">
                <field name="DETAIL_INDEX">4</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="codex_increment_count">
            <field name="VAR" id="codex_trade_count" variabletype="">session trade count</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="codex_count_math">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="codex_count_before">
                    <field name="VAR" id="codex_trade_count" variabletype="">session trade count</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="codex_one">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="codex_risk_gate">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_operation" id="codex_gate_and">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="codex_count_limit">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="variables_get" id="codex_count_read">
                            <field name="VAR" id="codex_trade_count" variabletype="">session trade count</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="codex_four">
                            <field name="NUM">4</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="codex_loss_limit">
                        <field name="OP">GT</field>
                        <value name="A">
                          <block type="variables_get" id="codex_profit_read">
                            <field name="VAR" id="codex_net_profit" variabletype="">session net profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="codex_minus_five">
                            <field name="NUM">-5</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_again" id="codex_trade_again"></block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="codex_stop_notice">
                    <field name="NOTIFICATION_TYPE">warn</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="codex_stop_text">
                        <field name="TEXT">Guard reached. This demo-bot run has stopped.</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="codex_before_purchase" deletable="false" x="20" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="sma_statement" id="codex_fast_sma_statement">
        <field name="VARIABLE" id="codex_fast_sma" variabletype="">fast SMA</field>
        <statement name="STATEMENT">
          <block type="input_list" id="codex_fast_input">
            <value name="INPUT_LIST">
              <block type="ticks" id="codex_fast_ticks"></block>
            </value>
            <next>
              <block type="period" id="codex_fast_period">
                <value name="PERIOD">
                  <block type="math_number" id="codex_fast_twenty">
                    <field name="NUM">20</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="sma_statement" id="codex_slow_sma_statement">
            <field name="VARIABLE" id="codex_slow_sma" variabletype="">slow SMA</field>
            <statement name="STATEMENT">
              <block type="input_list" id="codex_slow_input">
                <value name="INPUT_LIST">
                  <block type="ticks" id="codex_slow_ticks"></block>
                </value>
                <next>
                  <block type="period" id="codex_slow_period">
                    <value name="PERIOD">
                      <block type="math_number" id="codex_slow_fifty">
                        <field name="NUM">50</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="codex_direction_choice">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="codex_sma_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="variables_get" id="codex_fast_read">
                        <field name="VAR" id="codex_fast_sma" variabletype="">fast SMA</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="codex_slow_read">
                        <field name="VAR" id="codex_slow_sma" variabletype="">slow SMA</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="purchase" id="codex_buy_call">
                    <field name="PURCHASE_LIST">CALL</field>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="purchase" id="codex_buy_put">
                    <field name="PURCHASE_LIST">PUT</field>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
